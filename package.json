{
  "name": "directory-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "bun run --bun concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun run --cwd server dev",
    "dev:client": "bun run --cwd client dev",
    "build": "bun run --cwd client build",
    "seed": "bun run --cwd server seed",
    "start": "bun run --cwd server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
